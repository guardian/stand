{
	"component": {
		"toggleSwitch": {
			"shared": {
				"display": { "$type": "string", "$value": "flex" },
				"alignItems": { "$type": "string", "$value": "center" },
				"gap": { "$type": "dimension", "$value": "{base.spacing.8Rem}" },
				"cursor": { "$type": "string", "$value": "pointer" },
				"color": {
					"$type": "color",
					"$value": "{semantic.colors.text.strong}"
				},
				"label": {
					"display": { "$type": "string", "$value": "flex" },
					"flexDirection": { "$type": "string", "$value": "column" },
					"alignItems": { "$type": "string", "$value": "flex-start" },
					"paddingBlock": {
						"$type": "dimension",
						"$value": "{base.spacing.2Rem}"
					}
				},
				"description": {
					"color": {
						"$type": "color",
						"$value": "{semantic.colors.text.weak}"
					},
					"typography": {
						"font": {
							"$type": "typography",
							"$value": "{semantic.typography.bodyXs.font}"
						},
						"letterSpacing": {
							"$type": "dimension",
							"$value": "{semantic.typography.bodyXs.letterSpacing}"
						},
						"fontWidth": {
							"$type": "number",
							"$value": "{semantic.typography.bodyXs.fontWidth}"
						}
					}
				},
				"track": {
					"display": { "$type": "string", "$value": "flex" },
					"alignItems": { "$type": "string", "$value": "center" },
					"padding": { "$type": "dimension", "$value": "{base.spacing.4Rem}" },
					"borderRadius": { "$type": "string", "$value": "100px" },
					"backgroundColor": {
						"$type": "color",
						"$value": "{semantic.colors.fill.neutralMedium}"
					},
					"transition": {
						"$type": "string",
						"$value": "background-color 200ms"
					},
					"selected": {
						"backgroundColor": {
							"$type": "color",
							"$value": "{semantic.colors.fill.selectedStrong}"
						}
					},
					"disabled": {
						"backgroundColor": {
							"$type": "color",
							"$value": "{semantic.colors.fill.disabled}"
						}
					},
					"focusVisible": {
						"outline": {
							"$type": "border",
							"$value": {
								"color": "{semantic.colors.border.focused}",
								"width": "{semantic.sizing.border.md}",
								"style": "solid"
							}
						},
						"outlineOffset": {
							"$type": "dimension",
							"$value": "{base.spacing.2Rem}"
						}
					}
				},
				"thumb": {
					"borderRadius": { "$type": "string", "$value": "50%" },
					"backgroundColor": {
						"$type": "color",
						"$value": "{semantic.colors.fill.unselectedStrong}"
					},
					"color": {
						"$type": "color",
						"$value": "{semantic.colors.fill.selectedStrong}"
					},
					"disabled": {
						"color": {
							"$type": "color",
							"$value": "{semantic.colors.fill.disabled}"
						}
					},
					"transition": { "$type": "string", "$value": "transform 200ms" }
				},
				"disabled": {
					"color": {
						"$type": "color",
						"$value": "{semantic.colors.text.disabled}"
					},
					"cursor": { "$type": "string", "$value": "not-allowed" }
				}
			},
			"sm": {
				"typography": {
					"font": {
						"$type": "typography",
						"$value": "{semantic.typography.labelFormInlineSm.font}"
					},
					"letterSpacing": {
						"$type": "dimension",
						"$value": "{semantic.typography.labelFormInlineSm.letterSpacing}"
					},
					"fontWidth": {
						"$type": "number",
						"$value": "{semantic.typography.labelFormInlineSm.fontWidth}"
					}
				},
				"track": {
					"width": { "$type": "dimension", "$value": "2.75rem" },
					"height": {
						"$type": "dimension",
						"$value": "{base.sizing.size24Rem}"
					}
				},
				"thumb": {
					"size": { "$type": "dimension", "$value": "{base.sizing.size18Rem}" },
					"translateX": {
						"$type": "dimension",
						"$value": "{base.spacing.20Rem}"
					},
					"iconSize": {
						"$type": "dimension",
						"$value": "{base.sizing.size16Rem}"
					}
				}
			},
			"md": {
				"typography": {
					"font": {
						"$type": "typography",
						"$value": "{semantic.typography.labelFormInlineMd.font}"
					},
					"letterSpacing": {
						"$type": "dimension",
						"$value": "{semantic.typography.labelFormInlineMd.letterSpacing}"
					},
					"fontWidth": {
						"$type": "number",
						"$value": "{semantic.typography.labelFormInlineMd.fontWidth}"
					}
				},
				"track": {
					"width": { "$type": "dimension", "$value": "3.75rem" },
					"height": {
						"$type": "dimension",
						"$value": "{base.sizing.size32Rem}"
					}
				},
				"thumb": {
					"size": { "$type": "dimension", "$value": "{base.sizing.size24Rem}" },
					"translateX": { "$type": "dimension", "$value": "1.75rem" },
					"iconSize": {
						"$type": "dimension",
						"$value": "{base.sizing.size20Rem}"
					}
				}
			}
		}
	}
}
