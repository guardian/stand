{
	"component": {
		"table": {
			"cell": {
				"paddingBlock": {
					"$type": "dimension",
					"$value": "{base.spacing.8Rem}"
				},
				"paddingInline": {
					"$type": "dimension",
					"$value": "{base.spacing.12Rem}"
				},
				"typography": {
					"font": {
						"$type": "typography",
						"$value": "{semantic.typography.bodySm.font}"
					},
					"fontWidth": {
						"$type": "number",
						"$value": "{semantic.typography.bodySm.fontWidth}"
					},
					"letterSpacing": {
						"$type": "dimension",
						"$value": "{semantic.typography.bodySm.letterSpacing}"
					}
				}
			},
			"columnHeader": {
				"minHeight": {
					"$type": "dimension",
					"$value": "{semantic.sizing.height.lg}"
				},
				"typography": {
					"font": {
						"$type": "typography",
						"$value": "{semantic.typography.bodyBoldSm.font}"
					},
					"fontWidth": {
						"$type": "number",
						"$value": "{semantic.typography.bodyBoldSm.fontWidth}"
					},
					"letterSpacing": {
						"$type": "dimension",
						"$value": "{semantic.typography.bodyBoldSm.letterSpacing}"
					}
				}
			},
			"compactLabel": {
				"color": {
					"$type": "color",
					"$value": "{semantic.colors.text.weak}"
				},
				"gap": {
					"$type": "dimension",
					"$value": "{base.spacing.4Rem}"
				},
				"typography": {
					"font": {
						"$type": "typography",
						"$value": "{semantic.typography.bodyXs.font}"
					},
					"fontWidth": {
						"$type": "number",
						"$value": "{semantic.typography.bodyXs.fontWidth}"
					},
					"letterSpacing": {
						"$type": "dimension",
						"$value": "{semantic.typography.bodyXs.letterSpacing}"
					}
				}
			},
			"header": {
				"backgroundColor": {
					"$type": "color",
					"$value": "{semantic.colors.bg.raisedLevel2}"
				},
				"border": {
					"$type": "border",
					"$value": {
						"color": "{semantic.colors.border.weak}",
						"style": "solid",
						"width": "{semantic.sizing.border.default}"
					}
				}
			},
			"row": {
				"backgroundColor": {
					"$type": "color",
					"$value": "{semantic.colors.bg.base}"
				},
				"border": {
					"$type": "border",
					"$value": {
						"color": "{semantic.colors.border.weak}",
						"style": "solid",
						"width": "{semantic.sizing.border.default}"
					}
				},
				"focusVisible": {
					"outline": {
						"$type": "border",
						"$value": {
							"color": "{semantic.colors.border.focused}",
							"style": "solid",
							"width": "{semantic.sizing.border.md}"
						}
					},
					"outlineOffset": {
						"$type": "dimension",
						"$value": {
							"unit": "rem",
							"value": -0.0625
						}
					}
				},
				"hoverBackgroundColor": {
					"$type": "color",
					"$value": "{semantic.colors.bg.raisedLevel1}"
				}
			},
			"table": {
				"backgroundColor": {
					"$type": "color",
					"$value": "{semantic.colors.bg.base}"
				},
				"border": {
					"$type": "border",
					"$value": {
						"color": "{semantic.colors.border.weak}",
						"style": "solid",
						"width": "{semantic.sizing.border.default}"
					}
				},
				"borderRadius": {
					"$type": "dimension",
					"$value": "{semantic.radius.cornerSm}"
				},
				"color": {
					"$type": "color",
					"$value": "{semantic.colors.text.strong}"
				},
				"width": {
					"$type": "dimension",
					"$value": {
						"unit": "%",
						"value": 100
					}
				}
			}
		}
	}
}
