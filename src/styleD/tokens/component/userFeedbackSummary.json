				},
				"paddingTop": {
					"$type": "dimension",
					"$value": "{base.spacing.12Rem}"
				},
				"paddingRight": {
					"$type": "dimension",
					"$value": "{base.spacing.16Rem}"
				},
				"paddingBottom": {
					"$type": "dimension",
					"$value": "{base.spacing.12Rem}"
				},
				"paddingLeft": {
					"$type": "dimension",
					"$value": "{base.spacing.8Rem}"
				},
				"maxWidth": {
